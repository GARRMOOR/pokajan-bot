.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.hypothesis/

# Training artifacts — large, regenerable, synced deliberately not incidentally
checkpoints/
runs/
*.pt
*.ckpt

# Captured game data: screenshots are large and carry the usernames of real
# people in a live online match. Nothing image-shaped leaves this machine.
#
# Tracked selectively — the transcribed observations in *.yaml are the durable
# artifact, and they contain no personal data. See data/captures/README.md.
data/**
!data/**/
!data/captures/README.md
!data/**/*.yaml
!data/**/*.md

# Machine-specific overlay geometry — a property of a monitor, not the project.
overlay.json
